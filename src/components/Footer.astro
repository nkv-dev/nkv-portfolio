---
import GithubIcon from "@tabler/icons/outline/brand-github.svg";
import LinkedinIcon from "@tabler/icons/outline/brand-linkedin.svg";
import XIcon from "@tabler/icons/outline/brand-x.svg";
import MailIcon from "@tabler/icons/outline/mail.svg";
import ArrowUpIcon from "@tabler/icons/outline/arrow-up.svg";
---

<footer class="border-border/60 border-t bg-background">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="footer-content grid gap-10 md:grid-cols-3">
      <div class="footer-brand">
        <h3 class="text-lg font-semibold">Nitesh Kumar Verma</h3>
        <p class="text-muted-foreground text-sm">BCA Student</p>
        <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
          Building modern web experiences and exploring the intersection of software and hardware.
        </p>
      </div>

      <div class="footer-links">
        <h4 class="text-sm font-semibold tracking-wider uppercase">Quick Links</h4>
        <ul class="mt-4 space-y-2">
          <li><a href="#hero" class="footer-link text-muted-foreground hover:text-amber-500 text-sm transition-colors">Home</a></li>
          <li><a href="#about" class="footer-link text-muted-foreground hover:text-amber-500 text-sm transition-colors">About</a></li>
          <li><a href="#projects" class="footer-link text-muted-foreground hover:text-amber-500 text-sm transition-colors">Projects</a></li>
          <li><a href="#contact" class="footer-link text-muted-foreground hover:text-amber-500 text-sm transition-colors">Contact</a></li>
        </ul>
      </div>

      <div class="footer-social">
        <h4 class="text-sm font-semibold tracking-wider uppercase">Connect</h4>
        <div class="mt-4 flex gap-3">
          <a href="https://github.com/nkv-dev" target="_blank" class="footer-social-link text-muted-foreground hover:text-amber-500 transition-colors" aria-label="GitHub">
            <GithubIcon class="size-6" />
          </a>
          <a href="https://www.linkedin.com/in/nitesh-kumar-verma-408249334/" target="_blank" class="footer-social-link text-muted-foreground hover:text-amber-500 transition-colors" aria-label="LinkedIn">
            <LinkedinIcon class="size-6" />
          </a>
          <a href="https://x.com/nkv_dev" target="_blank" class="footer-social-link text-muted-foreground hover:text-amber-500 transition-colors" aria-label="Twitter">
            <XIcon class="size-6" />
          </a>
          <a href="mailto:nitesh.techcollab@gmail.com" class="footer-social-link text-muted-foreground hover:text-amber-500 transition-colors" aria-label="Email">
            <MailIcon class="size-6" />
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom mt-10 border-t border-border pt-6">
      <div class="footer-bottom-content flex flex-col items-center justify-between gap-3 sm:flex-row">
        <p class="copyright text-muted-foreground text-sm">© 2026 Nitesh Kumar Verma. All rights reserved.</p>
      </div>
    </div>
  </div>

  <button
    class="back-to-top bg-primary text-primary-foreground hover:bg-primary/90 fixed right-5 bottom-5 z-40 hidden size-11 items-center justify-center rounded-full shadow-lg transition-all"
    id="backToTop"
    aria-label="Back to top"
  >
    <ArrowUpIcon class="size-5" aria-hidden="true" />
  </button>
</footer>

<script>
  import '../scripts/footer.js';
</script>