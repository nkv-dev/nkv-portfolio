---
import { Badge } from "@/components/starwind/badge";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/starwind/card";
import TrophyIcon from "@tabler/icons/outline/trophy.svg";
import UsersIcon from "@tabler/icons/outline/users.svg";
import HeadsetIcon from "@tabler/icons/outline/headset.svg";
import CodeIcon from "@tabler/icons/outline/code.svg";
import FlameIcon from "@tabler/icons/outline/flame.svg";
import ArrowRightIcon from "@tabler/icons/outline/arrow-right.svg";

interface Achievement {
  icon: string;
  date: string;
  title: string;
  description: string;
  link?: { href: string; label: string };
  badge?: string;
}

const achievements: Achievement[] = [
  {
    icon: "trophy",
    date: "2024",
    title: "2nd Place - HackSphere-2024",
    description:
      "Led team to 2nd place + cash prize at New Horizon College of Engineering hackathon. Built EdTech solution using C++ and Virtual Interface Application for real-time key remapping to enhance productivity.",
  },
  {
    icon: "trophy",
    date: "2025",
    title: "2nd Prize - Project Expo",
    description:
      "Won 2nd prize at Nagarjuna Degree College Project Expo for USB-to-USB Key Code Converter (Macro Keyboard). Built with Arduino Leonardo and USB Host Shield for programmable key inputs.",
    link: { href: "https://lnkd.in/gEz6Fq8K", label: "View GitHub" },
  },
  {
    icon: "users",
    date: "2024",
    title: "Technical Seminar - Git & GitHub",
    description:
      "Conducted technical seminar for 150+ BCA students at MSRCASC on Git and GitHub fundamentals, version control workflows, and collaborative development practices.",
    badge: "Mentorship",
  },
  {
    icon: "headset",
    date: "Ongoing",
    title: "Department Tech Lead - BCA MSRCASC",
    description:
      "Serving as Tech Student Assistant and Department Tech Lead for BCA department. Providing comprehensive tech support to faculty and optimizing teaching workflows.",
    badge: "Tech Support",
  },
  {
    icon: "code",
    date: "2025",
    title: "Best Computer Assembly & Repair Student",
    description:
      "Recognized as best computer assembly and repair student at MSRCASC. Taught 250+ young students about modern computers and hardware fundamentals.",
    badge: "Hardware & Teaching",
  },
  {
    icon: "flame",
    date: "2024",
    title: "87-Day Python Mastery Challenge",
    description:
      "Completed Code with Harry's comprehensive Python course in just 87 days through #LearnInPublic approach. Documented entire coding journey publicly on X (Twitter).",
    link: { href: "https://x.com/nkv_dev", label: "View Journey" },
  },
];

const icons: Record<string, typeof TrophyIcon> = {
  trophy: TrophyIcon,
  users: UsersIcon,
  headset: HeadsetIcon,
  code: CodeIcon,
  flame: FlameIcon,
};
---

<section class="scroll-mt-16 border-border/60 border-b bg-background py-24" id="achievements">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <Badge variant="outline" eyebrow class="mb-4">Achievements</Badge>
      <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">Notable Achievements</h2>
      <p class="text-muted-foreground mt-4 text-lg max-w-2xl mx-auto">
        Milestones, certifications, and recognitions along my journey.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        achievements.map((item) => {
          const Icon = icons[item.icon];
          return (
            <Card class="hover:border-primary/50 transition-colors">
              <CardHeader>
                <Badge variant="outline" class="size-10 rounded-full p-2.5">
                  <Icon class="size-5" aria-hidden="true" />
                </Badge>
                <CardTitle class="mt-3">{item.title}</CardTitle>
              </CardHeader>
              <CardContent>
                <span class="text-primary text-xs font-semibold tracking-wider uppercase">{item.date}</span>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{item.description}</p>
                {
                  item.badge && <Badge variant="secondary" size="sm" class="mt-4">{item.badge}</Badge>
                }
                {
                  item.link && (
                    <a
                      href={item.link.href}
                      target="_blank"
                      class="text-primary hover:text-primary-accent mt-4 inline-flex items-center gap-1 text-sm font-semibold transition-colors"
                    >
                      {item.link.label} <ArrowRightIcon class="size-4" aria-hidden="true" />
                    </a>
                  )
                }
              </CardContent>
            </Card>
          );
        })
      }
    </div>
  </div>
</section>