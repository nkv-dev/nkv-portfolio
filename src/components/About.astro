---
import { Image } from 'astro:assets';
import profileImg from '../../public/images/profile.png';
import { Avatar, AvatarFallback, AvatarImage } from "@/components/starwind/avatar";
import { Badge } from "@/components/starwind/badge";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/starwind/dialog";
import GithubIcon from "@tabler/icons/outline/brand-github.svg";
import LinkedinIcon from "@tabler/icons/outline/brand-linkedin.svg";
import XIcon from "@tabler/icons/outline/brand-x.svg";
import BooksIcon from "@tabler/icons/outline/books.svg";
import SparklesIcon from "@tabler/icons/outline/sparkles.svg";
import TargetIcon from "@tabler/icons/outline/target.svg";
import CheckIcon from "@tabler/icons/outline/circle-check.svg";
---

<section class="scroll-mt-16 border-border/60 border-b bg-background py-24" id="about">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center">
      <Badge variant="outline" eyebrow class="mb-4">About me</Badge>
      <h2 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">About Me</h2>
      <p class="text-muted-foreground mt-4 text-lg max-w-2xl mx-auto">
        Curious software engineering student building modern and efficient digital experiences.
      </p>
    </div>

    <div class="mt-16 grid gap-10 md:grid-cols-[280px_1fr]">
      <aside class="bg-card ring-border mx-auto flex w-full max-w-xs flex-col items-center rounded-xl p-6 ring-1 md:mx-0">
        <Avatar size="lg" class="size-32">
          <AvatarImage src={profileImg.src} alt="Nitesh Kumar Verma" />
          <AvatarFallback>NV</AvatarFallback>
        </Avatar>

        <h5 class="mt-4 text-xl font-semibold">Nitesh Kumar Verma</h5>
        <p class="text-muted-foreground text-sm">BCA Student</p>

        <div class="mt-5 flex gap-3">
          <a href="https://github.com/nkv-dev" target="_blank" class="text-muted-foreground hover:text-amber-500 transition-colors" aria-label="GitHub">
            <GithubIcon class="size-6" />
          </a>
          <a href="https://www.linkedin.com/in/nitesh-kumar-verma-408249334/" target="_blank" class="text-muted-foreground hover:text-amber-500 transition-colors" aria-label="LinkedIn">
            <LinkedinIcon class="size-6" />
          </a>
          <a href="https://x.com/nkv_dev" target="_blank" class="text-muted-foreground hover:text-amber-500 transition-colors" aria-label="Twitter">
            <XIcon class="size-6" />
          </a>
        </div>
      </aside>

      <div>
        <Badge variant="outline" eyebrow class="mb-3">About</Badge>
        <h3 class="font-heading text-2xl font-semibold tracking-tight">Transforming Ideas into Digital Reality</h3>

        <p class="text-muted-foreground mt-4 leading-relaxed">
          I'm a software engineering student passionate about web development,
          embedded systems, Linux, and system-level programming.
          I enjoy understanding how things work under the hood and creating
          clean, scalable solutions.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <Dialog>
            <DialogTrigger asChild class:list={["bg-card ring-border hover:bg-muted flex flex-col gap-1 rounded-xl p-5 text-left ring-1 transition-colors cursor-pointer"]}>
              <span>
                <span class="text-primary flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase">
                  <BooksIcon class="size-4" /> Study
                </span>
                <span class="mt-2 text-sm font-medium">Software Engineering</span>
              </span>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Education</DialogTitle>
                <DialogDescription>My academic journey.</DialogDescription>
              </DialogHeader>
              <div class="mt-4 space-y-6">
                {
                  [
                    { year: "Current", title: "Bachelor of Computer Applications", college: "MS Ramaiah College of Arts Science & Commerce", meta: "CGPA – 9.3 | Final Year | Started 2023" },
                    { year: "2023", title: "CEBA", college: "St. Claret PU College", meta: "Percentage – 83" },
                    { year: "2021", title: "10th", college: "Harward International School", meta: "Percentage – 85" },
                  ].map((item) => (
                    <div class="border-border relative border-l-2 pl-4">
                      <span class="text-primary text-xs font-bold tracking-wider uppercase">{item.year}</span>
                      <h4 class="mt-1 font-semibold">{item.title}</h4>
                      <p class="text-muted-foreground text-sm">{item.college}</p>
                      <p class="text-muted-foreground text-xs">{item.meta}</p>
                    </div>
                  ))
                }
              </div>
            </DialogContent>
          </Dialog>

          <Dialog>
            <DialogTrigger asChild class:list={["bg-card ring-border hover:bg-muted flex flex-col gap-1 rounded-xl p-5 text-left ring-1 transition-colors cursor-pointer"]}>
              <span>
                <span class="text-primary flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase">
                  <SparklesIcon class="size-4" /> Interests
                </span>
                <span class="mt-2 text-sm font-medium">Web · Embedded · IOT and more</span>
              </span>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Interests</DialogTitle>
                <DialogDescription>What keeps me curious.</DialogDescription>
              </DialogHeader>
              <div class="mt-4 space-y-6">
                {
                  [
                    { year: "Primary", title: "Web Development", college: "Frontend & Backend", meta: "HTML · CSS · JavaScript · React" },
                    { year: "Systems", title: "Embedded Systems", college: "Microcontrollers & Hardware", meta: "Arduino · ESP32 · Sensors · IOT" },
                    { year: "Core", title: "Linux & System Programming", college: "Low-level & Performance", meta: "Linux · C/C++ · Bash · OS Internals" },
                    { year: "Creative", title: "Content Creation", college: "Tech & Learning", meta: "YouTube · Teaching · Documentation" },
                  ].map((item) => (
                    <div class="border-border relative border-l-2 pl-4">
                      <span class="text-primary text-xs font-bold tracking-wider uppercase">{item.year}</span>
                      <h4 class="mt-1 font-semibold">{item.title}</h4>
                      <p class="text-muted-foreground text-sm">{item.college}</p>
                      <p class="text-muted-foreground text-xs">{item.meta}</p>
                    </div>
                  ))
                }
              </div>
            </DialogContent>
          </Dialog>

          <div class="bg-card ring-border flex flex-col gap-1 rounded-xl p-5 ring-1">
            <span class="text-primary flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase">
              <TargetIcon class="size-4" /> Goal
            </span>
            <span class="mt-2 text-sm font-medium">Build impactful products</span>
          </div>

          <div class="bg-card ring-border flex flex-col gap-1 rounded-xl p-5 ring-1">
            <span class="text-primary flex items-center gap-1.5 text-xs font-semibold tracking-wider uppercase">
              <CheckIcon class="size-4" /> Status
            </span>
            <span class="mt-2 text-sm font-medium">Open to Work</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>